{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default launcher capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:event:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*.lutarea.com/*" },
        { "url": "https://lutarea.com/*" },
        { "url": "https://github.com/ALutenko/*" }
      ]
    },
    "updater:default"
  ]
}

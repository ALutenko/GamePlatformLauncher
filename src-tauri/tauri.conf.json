{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lutarea Launcher",
  "version": "0.2.0",
  "identifier": "com.lutarea.games.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lutarea Launcher",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#07060f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Lutarea",
    "copyright": "© 2026 Lutarea. All rights reserved.",
    "category": "Game",
    "shortDescription": "Lutarea Launcher",
    "longDescription": "Store and library for Lutarea games: The Kingdom of Beasts, Worldspire, Hotfix, Cartridge and more.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "section": "games"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/ALutenko/GamePlatformLauncher/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}

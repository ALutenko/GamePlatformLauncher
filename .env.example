# Games platform API (Platform/gamesplatform server).
# Dev: leave /api — vite proxies it to http://localhost:3001.
# Release builds: set the public host, e.g. https://platform.lutarea.com (games platform server)
VITE_API_BASE=/api

# Where key art / icons are served from. Empty = bundled copies in public/games.
VITE_ASSET_BASE=

# Web store opened from the launcher for purchases.
VITE_STORE_URL=https://store.lutarea.com
